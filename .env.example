# --- Worker identity ---
ENVIRONMENT=local
LOG_LEVEL=INFO
AGENT_NAME=clinic-voice-agent

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Platform backend ---
PLATFORM_URL=http://localhost:4226
INTERNAL_SERVICE_KEY=

# --- STT (deepgram nova-3 language=multi is the primary; openai is the fallback) ---
STT_PROVIDER=deepgram
STT_MODEL=nova-3
STT_LANGUAGE=multi
OPENAI_STT_MODEL=gpt-4o-transcribe
DEEPGRAM_API_KEY=

# --- LLM ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1
LLM_TEMPERATURE=0.3
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- TTS (Cartesia "Arushi" — bilingual Hinglish voice) ---
TTS_PROVIDER=cartesia
CARTESIA_MODEL=sonic-2
CARTESIA_VOICE_ID=95d51f79-c397-46f9-b49a-23763d3eaa2d
CARTESIA_API_KEY=

# --- Turn taking ---
MIN_ENDPOINTING_DELAY=0.4
MAX_ENDPOINTING_DELAY=5.0
ALLOW_INTERRUPTIONS=true
ENABLE_NOISE_CANCELLATION=true
TOOL_HOLDING_PHRASE_AFTER_SECONDS=1.2
